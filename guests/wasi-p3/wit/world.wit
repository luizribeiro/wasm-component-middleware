package example:wasi-p3;

world workload {
  import wasi:cli/environment@0.3.0;
  import wasi:cli/exit@0.3.0;
  import wasi:cli/stdin@0.3.0;
  import wasi:cli/stdout@0.3.0;
  import wasi:cli/stderr@0.3.0;
  import wasi:cli/terminal-stdin@0.3.0;
  import wasi:cli/terminal-stdout@0.3.0;
  import wasi:cli/terminal-stderr@0.3.0;
  import wasi:clocks/system-clock@0.3.0;
  import wasi:clocks/monotonic-clock@0.3.0;
  import wasi:filesystem/types@0.3.0;
  import wasi:filesystem/preopens@0.3.0;
  import wasi:random/random@0.3.0;
  import wasi:random/insecure@0.3.0;
  import wasi:random/insecure-seed@0.3.0;
  import wasi:sockets/types@0.3.0;
  import wasi:sockets/ip-name-lookup@0.3.0;

  export basic-system: async func();
  export common-calls: async func();
  export cancel-wait: async func();
  export abandon-wait: async func();
  export exercise: async func() -> string;
  export exit-success: async func();
  export exit-code: async func();
  export refused-open: async func() -> bool;
  export stream-read: async func(path: string, slow: bool) -> string;
  export stream-write: async func(path: string, size: u64) -> string;
  export stream-write-tolerant: async func(path: string, size: u64) -> string;
  export cancel-stream-read: async func(path: string);
  export cancel-stream-write: async func(path: string);
  export socket-denial: async func(port: u16) -> bool;
  export tcp-bind-denial: async func() -> bool;
  export udp-connect-denial: async func(port: u16) -> bool;
  export tcp-send-denial: async func(port: u16, size: u64) -> tuple<u64, bool>;
  export net-allowlist: async func(allowed-port: u16, denied-port: u16) -> string;
}
